# LLM_PROVIDER selects which client app/main.py builds — "gemini" (primary) or "anthropic"
# (fallback for when the Gemini free-tier daily quota is exhausted). Only the active provider's
# key is required to boot.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
CHAT_MODEL=gemini-3.6-flash
ANALYTICS_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
ANTHROPIC_ANALYTICS_MODEL=claude-haiku-4-5

SESSION_TTL_MINUTES=120
FORCE_BOOKING_FAILURE=
LOG_LEVEL=INFO
ALLOWED_ORIGINS=
